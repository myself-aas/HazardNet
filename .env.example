# HazardNet backend / Node server environment
# Copy to .env and fill in. The server logs loud startup warnings for
# anything missing (backend/server.js assertEnvironment).

# ── Required ──────────────────────────────────────────────────────────────
# Shared secret for authenticated endpoints (CSV ingest, push broadcast).
# Timing-safe verified; endpoints fail closed (503) when unset.
# The weekly workflow sends this as a Bearer token (secret: BACKEND_API_KEY).
BACKEND_API_KEY=

# ── AI providers (optional — fallback cascade ends in deterministic text) ──
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
OPENROUTER_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=

# ── Web push (optional) ───────────────────────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:alerts@hazardnet.example

# ── Server hardening (optional; set in production) ────────────────────────
# Comma-separated browser origins allowed by CORS.
FRONTEND_ORIGIN=
# Flip the helmet CSP from Report-Only to enforcing (ADR 0003 rollout).
CSP_ENFORCE=false
# Backend listen port (3001 is the dev convention via the Vite proxy).
PORT=3001

# ── Identity-aware rate limiting (optional) ───────────────────────────────
# Supabase project JWT secret — enables the authed vs anonymous AI lanes.
SUPABASE_JWT_SECRET=

# ── Forecast store (ADR 0002 cutover) ────────────────────────────────────
# 'firestore' (default, legacy applet DB) or 'supabase' (target).
# Before flipping: apply scripts/db/002_forecasts_supabase.sql and run
# scripts/migrate-firestore-to-supabase.mjs (dry-run, then RUN).
FORECAST_STORE=firestore
# Supabase Postgres connection string (required when FORECAST_STORE=supabase).
DATABASE_URL=
SUPABASE_SSL=true

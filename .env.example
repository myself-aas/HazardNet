# HazardNet environment template — PLACEHOLDERS ONLY.
#
# This is the only env file ever committed (docs/ENVIRONMENT_SECRETS.md §0).
# Copy it and fill real values locally:
#
#     cp .env.example .env
#
# Real values belong in exactly two other places: the Vercel project
# environment (serverless runtime + the Vite build) and GitHub Actions
# secrets/variables. Never commit them, and never paste them into an issue,
# a screenshot or a chat. `bash scripts/check-secrets.sh` is the leak scanner.
#
# Anything prefixed VITE_ is compiled into the public JS bundle — public
# identifiers only (docs/ENVIRONMENT_SECRETS.md §0, rule 2).

# ─────────────────────────────────────────────────────────────────────────────
# Frontend build — Vite (public by design)
# ─────────────────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=your_firebase_web_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=
# Set only for a named Firestore database; unset selects "(default)".
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_DATABASE_URL=
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VITE_CONTACT_EMAIL=you@example.com
VITE_VERCEL_ANALYTICS=
VITE_DOWNLOAD_GITHUB_OWNER=
VITE_DOWNLOAD_REPO_ANDROID=

# ─────────────────────────────────────────────────────────────────────────────
# Backend / serverless runtime (Vercel project env; local .env for self-host)
# ─────────────────────────────────────────────────────────────────────────────
# Bearer token for POST /api/v1/forecasts/update — generate with
# `openssl rand -hex 32`. Required for ingest; leave empty locally if unused.
BACKEND_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_BACKUP=
GROQ_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
# Firestore access. Paste the minified service-account JSON as ONE line.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
WEB_PUSH_CONTACT=mailto:you@example.com
# CORS allowlist, comma-separated. Production: https://www.hazardnet.live
FRONTEND_ORIGIN=http://localhost:3000
CSP_ENFORCE=
FORECAST_STORE=firestore
FORECAST_DATASET=hazardnet/weekly-forecasts
ALERT_AUTO_PUBLISH=false
ALERT_AUTO_PUBLISH_MINUTES=
ALERT_DUTY_OFFICERS=

# ─────────────────────────────────────────────────────────────────────────────
# Local development only (never set these in a deployment)
# ─────────────────────────────────────────────────────────────────────────────
# The backend defaults to :3000 (npm start serves frontend/dist there). The Vite
# dev server owns :3000 with strictPort and proxies /api, /metrics and /health to
# :3001, so run the API beside it with:  PORT=3001 npm run dev:api
PORT=3001
# Playwright / QA harness overrides (docs/codebase/TESTING.md)
E2E_BASE_URL=http://127.0.0.1:3000
QA_NO_API_RUNTIME=1
QA_CHROMIUM_PATH=

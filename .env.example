# HazardNet environment template.
#
# NO REAL CREDENTIAL MAY APPEAR IN THIS FILE. It is tracked in git, and
# `scripts/check-secrets.sh` (wired into CI) fails the build when a value in a
# tracked file looks like a credential. That gate used to be blind to this very
# file — see docs/audits/2026-09-18-secret-scan-false-negative.md — and the
# provider keys that had accumulated here are now placeholders; the real values
# must be rotated (they exist in git history).
#
# `public by design` marks values that are compiled into the browser bundle or
# are published identifiers. They are safe to commit; everything else is set per
# environment (Vercel project env vars, GitHub Actions secrets, or the local
# `.env` file, which is git-ignored).

# ── Backend ───────────────────────────────────────────────────────────────────
# Shared key for the pipeline/ingest routes; the backend returns 503 when unset
# (fail-closed, backend/utils/apiKeyAuth.js).
BACKEND_API_KEY=REPLACE_WITH_64_HEX_CHARS
BENCH_URL=https://hazardnet.live/api/ingest
CSP_ENFORCE=false

# ── Storage ───────────────────────────────────────────────────────────────────
DATABASE_URL=https://hazardnet-aas48424-default-rtdb.firebaseio.com
FORECAST_STORE=firestore

# ── Edge / CORS ───────────────────────────────────────────────────────────────
# Comma-separated allowlist. Production fails closed when unset.
FRONTEND_ORIGIN=https://www.hazardnet.live,https://hazardnet.live
VERCEL_ENV=production

# ── AI providers (all optional; the engine degrades in order) ────────────────
GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
GEMINI_API_KEY_BACKUP=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
GROQ_API_KEY=REPLACE_WITH_GROQ_KEY
HUGGINGFACE_API_KEY=REPLACE_WITH_HUGGINGFACE_TOKEN

# ── Data pipeline ────────────────────────────────────────────────────────────
KAGGLE_DATASET=ashifahmedshuvo/hazardnet-weekly-forecasts

# ── Web push (VAPID pair — regenerate with `npx web-push generate-vapid-keys`) ─
VAPID_PRIVATE_KEY=REPLACE_WITH_VAPID_PRIVATE_KEY
VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
WEB_PUSH_CONTACT=mailto:ashif-ahmed-shuvo@hazardnet-aas48424.iam.gserviceaccount.com

# ── Frontend (public by design: these ship in the browser bundle) ────────────
VITE_ADSENSE_CLIENT=VITE_ADSENSE_CLIENT
VITE_ADSENSE_SLOT_ARTICLE_FOOTER=VITE_ADSENSE_SLOT_ARTICLE_FOOTER
VITE_ADSENSE_SLOT_ARTICLE_INLINE=VITE_ADSENSE_SLOT_ARTICLE_INLINE
VITE_ADSENSE_SLOT_BLOG_INDEX=VITE_ADSENSE_SLOT_BLOG_INDEX
VITE_FIREBASE_API_KEY=AIzaSyBwyxWm0MIQlTmjJ-NKPKjl72AYLS7oDqQ
VITE_FIREBASE_APP_ID=1:1053636076316:web:0fbe66d8e4b90c2de9d0d9
VITE_FIREBASE_AUTH_DOMAIN=hazardnet-aas48424.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://hazardnet-aas48424-default-rtdb.firebaseio.com
# Firestore database id: use the AI-Studio applet database id in production
# (matches firebase-applet-config.json and backend/db.js). For local dev you
# may use `(default)` if your project only has the default database. Avoid
# bare `default` — the SDK expects `(default)` or a named id.
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-hazardnet-55b49dbf-625b-492b-9cff-feabd729e843
VITE_FIREBASE_MEASUREMENT_ID=G-G40YRHHD94
VITE_FIREBASE_MESSAGING_SENDER_ID=1053636076316
VITE_FIREBASE_PROJECT_ID=hazardnet-aas48424
VITE_FIREBASE_STORAGE_BUCKET=hazardnet-aas48424.firebasestorage.app
VITE_VAPID_PUBLIC_KEY=REPLACE_WITH_VAPID_PUBLIC_KEY
VITE_VERCEL_ANALYTICS=vcp_0BIONpJARYHz3ZwJ3KvCVcPwWPcAsQmzsdqg9JFsePWFyRV4413tRKtw

# ── Alert engine (PRODUCT_SPEC §1.3 levels, §1.6 human-in-the-loop) ────────────
# See docs/alerts/ALERT_ENGINE.md. All optional: the defaults are conservative and
# the engine reports which values are overrides on GET /api/v1/alerts/policy.
ALERT_WATCH_PROBABILITY=
ALERT_WARNING_PROBABILITY=
ALERT_WATCH_SEVERITY=
ALERT_DIVERGENCE_WATCH=
ALERT_ALLOW_UNCALIBRATED_WARNING=
ALERT_MAX_AUTO_PUBLISH_LEVEL=
ALERT_MAX_PREDICTION_AGE_HOURS=
ALERT_AUTO_PUBLISH=
ALERT_AUTO_PUBLISH_MINUTES=
ALERT_NOTIFY_TIMEOUT_MS=
# Comma-separated Firebase uids/emails allowed to approve or reject an alert.
ALERT_DUTY_OFFICERS=
# SMS gateway: SMS_PROVIDER=bulksmsbd|greenweb|none, SMS_DRY_RUN=true previews the
# exact request (credentials redacted) without sending. Bengali messages are UCS-2
# and cost ~3x the segments of English — SMS_MAX_PER_RUN caps the bill.
SMS_PROVIDER=
SMS_SENDER_ID=
SMS_DRY_RUN=
SMS_MAX_PER_RUN=
BULKSMSBD_API_KEY=
GREENWEB_API_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# Durable server-only forecast writes (ADR 0014). Never prefix this with VITE_.
# Prefer workload identity / Application Default Credentials where available.
# On other hosts, set FIREBASE_SERVICE_ACCOUNT_JSON in the platform secret store
# to a service account with Firestore data-write access to the configured project.
# Do not paste credentials into this tracked template. Missing/invalid credentials
# fail ingestion; snapshot-backed reads remain available.
FIREBASE_SERVICE_ACCOUNT_JSON=

# ------------------------------------------------------------
# HazardNet Environment Configuration TEMPLATE
# ⚠️ Values below are PLACEHOLDERS. Real credentials live in
#    GitHub Secrets (repo Settings → Secrets and variables → Actions)
#    and must NEVER be committed to this repository.
# ------------------------------------------------------------
# General
# -------------------------------------------------------------------
# The port the backend server will listen on (development preview)
PORT=3000

# Backend API secret (required for authenticated endpoints)
BACKEND_API_KEY=REPLACE_WITH_BACKEND_API_KEY_FROM_GITHUB_SECRETS

# Frontend origin (adjust for each environment)
# For local development use http://localhost:${PORT}
# For preview use the preview URL, for production use your production domain.
FRONTEND_ORIGIN=https://www.hazardnet.live/

# Content Security Policy – set to true in production to enforce CSP
CSP_ENFORCE=false

# -------------------------------------------------------------------
# AI Provider Keys (replace with your actual keys)
# -------------------------------------------------------------------
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY
GEMINI_API_KEY_BACKUP=REPLACE_WITH_BACKUP_GEMINI_KEY
OPENROUTER_API_KEY=REPLACE_WITH_YOUR_OPENROUTER_KEY
GROQ_API_KEY=REPLACE_WITH_YOUR_GROQ_KEY
HUGGINGFACE_API_KEY=REPLACE_WITH_YOUR_HF_TOKEN

# -------------------------------------------------------------------
# Web Push (Firebase/Push) – generate a VAPID pair per environment
# -------------------------------------------------------------------
VAPID_PUBLIC_KEY=REPLACE_WITH_GENERATED_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=REPLACE_WITH_GENERATED_VAPID_PRIVATE_KEY
WEB_PUSH_CONTACT=mailto:shuvo.1807016@bau.edu.bd

# -------------------------------------------------------------------
# Supabase / Postgres configuration (used when FORECAST_STORE=supabase)
# -------------------------------------------------------------------
SUPABASE_JWT_SECRET=REPLACE_WITH_SUPABASE_JWT_SECRET
FORECAST_STORE=firestore
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
SUPABASE_SSL=true

# -------------------------------------------------------------------
# Kaggle (optional – used for data import scripts)
# -------------------------------------------------------------------
KAGGLE_API_TOKEN=REPLACE_WITH_KAGGLE_API_TOKEN
KAGGLE_USERNAME=ashifahmedshuvo

# -------------------------------------------------------------------
# CI/CD specific overrides – you can source this file in your CI pipeline
# -------------------------------------------------------------------
# Example for GitHub Actions:
#   echo "VITE_BUILD_MODE=ci" >> $GITHUB_ENV
#   echo "PORT=3001" >> $GITHUB_ENV

# ------------------------------------------------------------
# End of .env
# ------------------------------------------------------------


{
  "name": "hazardnet",
  "version": "2.1.911",
  "description": "Multi-Hazard AI Classification & Severity Quantification for Bangladesh Agricultural Disaster Risk",
  "keywords": [
    "HazardNet",
    "Multi-Hazards",
    "Classification",
    "Artificial",
    "Intelligence",
    "First",
    "Principle"
  ],
  "homepage": "https://github.com/myself-aas/HazardNet#readme",
  "bugs": {
    "url": "https://github.com/myself-aas/HazardNet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myself-aas/HazardNet.git"
  },
  "license": "MIT",
  "author": "Ashif Ahmed Shuvo",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run build:frontend && node backend/server.js",
    "start": "node backend/server.js",
    "build": "npm run build:frontend && node scripts/copy-dist.mjs",
    "build:frontend": "npm --prefix frontend run build",
    "build:frontend:copy": "npm run build",
    "lint": "tsc -p frontend/tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "lint:eslint": "eslint .",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx}\" \"backend/**/*.js\" \"api/**/*.js\"",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:rag-freshness": "node scripts/check-rag-freshness.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.15.0",
    "@tensorflow/tfjs": "^4.12.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^12.17.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "9",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^7.22.11",
    "@babel/preset-env": "^7.22.11",
    "@babel/preset-react": "^7.22.6",
    "@babel/preset-typescript": "^7.22.5",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^7.2.1",
    "babel-jest": "^30.4.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.4.1",
    "node-mocks-http": "^1.11.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=20"
  }
}

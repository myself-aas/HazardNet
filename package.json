{
  "name": "hazardnet",
  "version": "2.1.9",
  "private": true,
  "description": "Multi-Hazard AI Classification & Severity Quantification for Bangladesh Agricultural Disaster Risk",
  "keywords": [
    "HazardNet",
    "Multi-Hazards",
    "Classification",
    "Artificial",
    "Intelligence",
    "First",
    "Principle"
  ],
  "homepage": "https://github.com/myself-aas/HazardNet#readme",
  "bugs": {
    "url": "https://github.com/myself-aas/HazardNet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myself-aas/HazardNet.git"
  },
  "license": "MIT",
  "author": "Ashif Ahmed Shuvo",
  "type": "module",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "node scripts/ensure-frontend.mjs && node backend/server.js",
    "start": "node backend/server.js",
    "build": "npm run build:frontend && node scripts/copy-dist.mjs",
    "build:frontend": "npm --prefix frontend run build",
    "build:frontend:copy": "npm run build",
    "lint": "tsc -p frontend/tsconfig.json --noEmit",
    "test": "jest --passWithNoTests",
    "lint:eslint": "eslint .",
    "format": "prettier --write \"frontend/src/**/*.{ts,tsx}\" \"backend/**/*.js\" \"api/**/*.js\"",
    "alerts:rehearse": "node scripts/rehearse_alert_engine.mjs --out /tmp/alert-run.json",
    "alerts:snapshot": "node scripts/rehearse_alert_engine.mjs --out /tmp/alert-run.json --quiet && node scripts/build_alert_snapshot.mjs --in /tmp/alert-run.json",
    "check:bundle": "node scripts/check-bundle.mjs",
    "check:phase7": "node scripts/check-phase7.mjs",
    "check:ux-release": "node scripts/check-ux-release.mjs",
    "check:design": "node scripts/check-design-quality.mjs",
    "check:design:source": "node scripts/check-design-quality.mjs --source-only",
    "check:paths": "node scripts/check-public-paths.mjs",
    "check:design:update": "node scripts/check-design-quality.mjs --update",
    "design:detect": "impeccable detect frontend/src frontend/dist --no-advisory",
    "design:help": "impeccable help",
    "check:rag-freshness": "node scripts/check-rag-freshness.mjs",
    "check:env": "node scripts/validate_env.mjs",
    "check:embargo": "node scripts/check-severity-embargo.mjs",
    "archive:build": "node scripts/build_hazard_archive.mjs",
    "archive:check": "node scripts/build_hazard_archive.mjs --check",
    "archive:rag": "node scripts/build_archive_rag_docs.mjs",
    "archive:rag:check": "node scripts/build_archive_rag_docs.mjs --check",
    "archive:load": "cd scripts && python3 -m etl.cli events --input ../data/events/historical_hazard_records_with_HazardNet_severity.csv --adapter bgd-climatic-hazards --claimed-total 2931 --export-json ../data/events/hazardnet-events.json"
  },
  "dependencies": {
    "@google-cloud/firestore": "^7.11.6",
    "@google/genai": "^2.15.0",
    "busboy": "^1.6.0",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.1",
    "dompurify": "^3.4.15",
    "dotenv": "^17.4.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.5.0",
    "firebase": "^12.17.0",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.0",
    "multer": "^2.2.0",
    "prom-client": "^15.1.3",
    "web-push": "^3.6.7",
    "ws": "^8.21.3",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.11",
    "@babel/preset-env": "^7.22.11",
    "@babel/preset-react": "^7.22.6",
    "@babel/preset-typescript": "^7.22.5",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/jest-axe": "^3.5.9",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "babel-jest": "^30.4.1",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.11.0",
    "impeccable": "^4.1.0",
    "jest": "^29.7.0",
    "jest-axe": "^9.0.0",
    "jest-environment-jsdom": "^30.4.1",
    "node-mocks-http": "^1.11.0",
    "prettier": "^3.6.2",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.46.0"
  },
  "engines": {
    "node": ">=20"
  }
}

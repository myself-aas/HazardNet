# ═══════════════════════════════════════════════════════════════════════════
#  HazardNet frontend (Vite) — environment template
# ═══════════════════════════════════════════════════════════════════════════
#
#  Copy to `frontend/.env` (gitignored) and fill in:
#
#      cp frontend/.env.example frontend/.env
#
#  Everything in this file is OPTIONAL. Firebase identifiers have working
#  defaults in frontend/src/lib/config.ts (public-by-design, ADR 0001), so the
#  app boots with no .env at all.
#
#  ⚠️  FOUR KEYS DO NOT WORK FROM THIS FILE. frontend/vite.config.ts injects
#      them with an explicit `define` block that reads the REPOSITORY ROOT
#      env (loadEnv(mode, '..')), and a `define` substitution wins over
#      whatever Vite loads here. Set these in the root `.env` instead:
#
#        VITE_SUPABASE_URL              → root NEXT_PUBLIC_SUPABASE_URL or SUPABASE_URL
#        VITE_SUPABASE_PUBLISHABLE_KEY  → root NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY,
#                                         SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY
#        VITE_SUPABASE_REDIRECT_URL     → root NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL
#        VITE_VERCEL_ANALYTICS          → root VITE_VERCEL_ANALYTICS
#
#      (Verified by build: decoys in this file never reach the bundle, while
#      the root-level values do. See §7 of the root .env.example.)
#
#  The keys below are NOT in that define block, so this file is the correct
#  place for them.
# ═══════════════════════════════════════════════════════════════════════════


# ── Web push public key ────────────────────────────────────────────────────
# Must be the SAME keypair as the backend's VAPID_PUBLIC_KEY. Read by
# frontend/src/services/pushNotification.ts.
VITE_VAPID_PUBLIC_KEY=


# ── Firebase client identifiers (optional overrides) ───────────────────────
# The defaults in frontend/src/lib/config.ts are the canonical public web
# config for project hazardnet-aas48424. Override only to point a build at a
# different Firebase project.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Applet Firestore database id (legacy forecast store; removed by the
# ADR 0002 cutover).
VITE_FIREBASE_FIRESTORE_DATABASE_ID=


# ── Blog monetization (optional) ───────────────────────────────────────────
# The AdSense loader is injected ONLY when VITE_ADSENSE_CLIENT is non-empty,
# so a blank value costs nothing and makes no third-party request.
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_BLOG_INDEX=
VITE_ADSENSE_SLOT_ARTICLE_INLINE=
VITE_ADSENSE_SLOT_ARTICLE_FOOTER=


# ── NOTE: no VITE_SUPABASE_* or VITE_VERCEL_ANALYTICS here ────────────────
# Those four keys are defined (shadowed) by the Vite config and must be set in
# the root `.env` — see the warning at the top of this file. Keeping the names
# out of this template is deliberate: an earlier revision documented them here,
# where they silently did nothing.

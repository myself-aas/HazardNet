# HazardNet frontend (Vite) environment
# Copy to frontend/.env. Defaults for the Firebase identifiers live in
# frontend/src/lib/config.ts (public-by-design, per ADR 0001) — the vars
# below override them per environment.

# ── Supabase (identity, profiles) ─────────────────────────────────────────
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_REDIRECT_URL=

# ── Web push public key (matches backend VAPID_PUBLIC_KEY) ────────────────
VITE_VAPID_PUBLIC_KEY=

# ── Firebase client identifiers (optional overrides; defaults are the
#    canonical public web config — see frontend/src/lib/config.ts) ─────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Applet Firestore database id (legacy forecast store; removed by the
# ADR 0002 cutover).
VITE_FIREBASE_FIRESTORE_DATABASE_ID=

# ── Blog monetization (optional) ──────────────────────────────────────────
VITE_ADSENSE_CLIENT=
VITE_ADSENSE_SLOT_BLOG_INDEX=
VITE_ADSENSE_SLOT_ARTICLE_INLINE=
VITE_ADSENSE_SLOT_ARTICLE_FOOTER=

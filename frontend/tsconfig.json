{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    // packages/core ships the shared agent/retrieval logic as .js with JSDoc. allowJs
    // lets tsc infer those types (verified: a deliberate mismatch still errors) without
    // hand-written .d.ts files that would drift. checkJs stays off.
    "allowJs": true,
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "baseUrl": "./",
    "paths": {
      "@/*": ["src/*"],
      "@hazardnet/design-system": ["../packages/design-system/src/index.ts"],
      "@hazardnet/design-system/*": ["../packages/design-system/src/*"],
      "@hazardnet/core": ["../packages/core/src/index.ts"],
      "@hazardnet/core/*": ["../packages/core/src/*"],
      "@hazardnet/analytics": ["../packages/analytics/src/index.ts"],
      "@hazardnet/analytics/*": ["../packages/analytics/src/*"],
      "@hazardnet/api": ["../packages/api/src/index.ts"],
      "@hazardnet/api/*": ["../packages/api/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/vite-env.d.ts"],
  "exclude": ["node_modules"]
}
# QA harness output (playwright.qa.config.ts)
/test-results-qa

# Collected retrain bundles (model_intake.yml downloads them, validates them and
# opens a pull request; the bytes belong in the PR, not in the repository twice).

# Expo prebuild output for apps/mobile — regenerated by CI (`npx expo prebuild`)
# or locally (`npm --workspace @hazardnet/mobile run prebuild`). Keep out of git.
apps/mobile/android/
apps/mobile/ios/
apps/mobile/.expo/

# Firebase local CLI cache
.firebase/

# Research and development scratch space for model training and evaluation. This is
# a temporary workspace for experiments and should not be committed to the repo.
kaggle-notebooks/
manuscript/

# Large research binaries and model checkpoints (CONCERNS.md resolution)
*.h5
*.pt
*.pth
*.keras
*.bin
# agent skill installers (npx skills) — tooling artifacts, not product
.agents/

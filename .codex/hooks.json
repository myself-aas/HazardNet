{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ -x node_modules/.bin/impeccable ] || exit 0; node_modules/.bin/impeccable hook",
            "commandWindows": "if not exist \"node_modules\\.bin\\impeccable.cmd\" (exit /b 0) & \"node_modules\\.bin\\impeccable.cmd\" hook",
            "timeout": 5,
            "statusMessage": "Checking UI changes"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ -x node_modules/.bin/impeccable ] || exit 0; node_modules/.bin/impeccable hook",
            "commandWindows": "if not exist \"node_modules\\.bin\\impeccable.cmd\" (exit /b 0) & \"node_modules\\.bin\\impeccable.cmd\" hook",
            "timeout": 30,
            "statusMessage": "Design deep pass"
          }
        ]
      }
    ]
  }
}

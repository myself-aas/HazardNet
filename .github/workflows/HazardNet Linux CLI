# =============================================================================
# HazardNet CI/Release workflow template - headless daemon & CLI (Linux)
#
# This file lives in .github/workflow-templates/ inside the HazardNet
# repository and is NOT executed there: GitHub Actions only runs workflows
# stored in .github/workflows/. To adopt it, copy this file into the daemon/CLI
# product repository as .github/workflows/hazardnet-daemon-cli-linux.yml, then
# edit the CONFIGURATION block below.
# See .github/workflow-templates/README.md for adoption steps, secrets and
# tag conventions.
#
# CI (every pull request and push to the default branch), on ubuntu-latest:
#   - fail-fast checks for the expected build entrypoint (CMakeLists.txt or
#     a build script), per build target in a configurable matrix
#   - configure + build via CMake (or a fully script-driven build)
#   - CTest test run (cmake mode) when enabled
#   - smoke check of the built binaries via a configurable command
#   - distributable tar.gz per target uploaded as CI artifacts
#
# Release (gated):
#   - only on a pushed strict-semver tag (vMAJOR.MINOR.PATCH[-pre][+build])
#     or a manual dispatch with release=true targeting a tag
#   - archives plus SHA256SUMS attached to a GitHub Release via the protected
#     'release' environment (create it in the product repository)
# =============================================================================

name: Daemon & CLI (Linux) CI & Release

on:
  push:
    branches:
      - main # <<< EDIT: default branch of the product repository
    tags:
      - 'v*' # release-gate enforces strict semver before anything publishes
  pull_request: # validation for pull requests targeting any branch
  workflow_dispatch:
    inputs:
      release:
        description: 'Publish a GitHub Release from this run (a semver tag is required)'
        required: true
        type: boolean
        default: false
      release_tag:
        description: 'Tag to publish (e.g. v1.2.3); required only when dispatching from a branch instead of a tag'
        required: false
        type: string
        default: ''

# Least privilege by default; only the release job escalates to contents:write.
permissions:
  contents: read

concurrency:
  # One lane per event type + ref, so validation runs cancel stale peers but
  # release runs (tag push or manual dispatch) are never cancelled mid-flight.
  group: ${{ github.workflow }}-${{ github.event_name }}-${{ github.ref }}
  cancel-in-progress: ${{ github.event_name != 'workflow_dispatch' && github.ref_type != 'tag' }}

env:
  # ---------------------------------------------------------------------------
  # CONFIGURATION - edit these defaults after copying into the product repo.
  # Every value is a plain string; an empty string disables the related step.
  # ---------------------------------------------------------------------------
  BUILD_SYSTEM: cmake # 'cmake' (CMakeLists.txt) or 'script' (BUILD_SCRIPT)
  CMAKE_SOURCE_DIR: '.' # repository-relative CMake source directory
  CMAKE_BUILD_TYPE: Release
  CMAKE_EXTRA_ARGS: '' # extra configure flags, e.g. '-DBUILD_DAEMON=ON -DBUILD_CLI=ON'
  CTEST_ENABLED: 'true' # run CTest after a cmake build
  CTEST_EXTRA_ARGS: '' # extra ctest flags, e.g. '--parallel 2'
  BUILD_SCRIPT: './scripts/build.sh' # used when BUILD_SYSTEM == 'script'
  SCRIPT_BUILD_ARGS: '' # extra args appended to BUILD_SCRIPT
  SMOKE_TEST_COMMAND: './scripts/smoke-test.sh' # '' disables; see README for the contract
  PACKAGE_PREFIX: hazardnet-daemon-cli # artifact/archive base name
  # One glob per line; everything matched is packed into the per-target archive.
  DIST_GLOBS: |
    build/bin/*
  ARTIFACT_RETENTION_DAYS: '14' # adjust to the product repository's policy

jobs:
  release-gate:
    name: Release gate (event + semver tag checks)
    runs-on: ubuntu-latest
    timeout-minutes: 5
    outputs:
      should-publish: ${{ steps.gate.outputs.should-publish }}
      tag: ${{ steps.gate.outputs.tag }}
      version: ${{ steps.gate.outputs.version }}
      prerelease: ${{ steps.gate.outputs.prerelease }}
    steps:
      - name: Decide whether this run is allowed to publish
        id: gate
        env:
          EVENT_NAME: ${{ github.event_name }}
          GITHUB_REF_NAME: ${{ github.ref_name }}
          GITHUB_REF_TYPE: ${{ github.ref_type }}
          INPUT_RELEASE: ${{ inputs.release }}
          INPUT_RELEASE_TAG: ${{ inputs.release_tag }}
        run: |
          set -euo pipefail

          semver_regex='^v(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\+[0-9A-Za-z.-]+)?$'

          should=false
          tag=''

          if [ "${EVENT_NAME}" = 'push' ] && [ "${GITHUB_REF_TYPE}" = 'tag' ]; then
            tag="${GITHUB_REF_NAME}"
            if printf '%s' "${tag}" | grep -Eq "${semver_regex}"; then
              should=true
            else
              # Non-semver tags still run validation; they simply never publish.
              echo "::warning::Tag '${tag}' is not strict semver (vMAJOR.MINOR.PATCH[-pre][+build]); running validation only."
            fi
          elif [ "${EVENT_NAME}" = 'workflow_dispatch' ] && [ "${INPUT_RELEASE}" = 'true' ]; then
            if [ "${GITHUB_REF_TYPE}" = 'tag' ]; then
              tag="${GITHUB_REF_NAME}"
            elif [ -n "${INPUT_RELEASE_TAG}" ]; then
              tag="${INPUT_RELEASE_TAG}"
            else
              echo "::error::Manual release requires a tag: dispatch this workflow with a tag selected, or provide the 'release_tag' input (e.g. v1.2.3)."
              exit 1
            fi
            if ! printf '%s' "${tag}" | grep -Eq "${semver_regex}"; then
              echo "::error::Release tag '${tag}' is not strict semver (vMAJOR.MINOR.PATCH[-pre][+build])."
              exit 1
            fi
            should=true
          fi

          version="${tag#v}"
          prerelease=false
          case "${version}" in
            *-*) prerelease=true ;;
          esac

          {
            echo "should-publish=${should}"
            echo "tag=${tag}"
            echo "version=${version}"
            echo "prerelease=${prerelease}"
          } >> "${GITHUB_OUTPUT}"

          echo "Event=${EVENT_NAME} publish=${should} tag=${tag:-<none>} prerelease=${prerelease}"
          if [ "${should}" != 'true' ]; then
            echo 'Validation-only run: pull requests and untagged pushes can never publish.'
          fi

  build:
    name: Build, test & package (${{ matrix.target }})
    needs: release-gate
    runs-on: ubuntu-latest
    timeout-minutes: 60
    strategy:
      fail-fast: false
      matrix:
        # Supported architectures/configurations. Add rows for more targets
        # (e.g. linux-aarch64 cross builds) and set cmake_toolchain per row.
        target:
          - linux-x86_64
        include:
          - target: linux-x86_64
            cmake_toolchain: ''
          # - target: linux-aarch64
          #   cmake_toolchain: ./.github/toolchains/aarch64-linux-gnu.cmake
    env:
      RELEASE_VERSION: ${{ needs.release-gate.outputs.version }}
      GITHUB_SHA_SHORT: ${{ github.sha }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Fail fast if the configured build entrypoint is missing
        env:
          MATRIX_TOOLCHAIN: ${{ matrix.cmake_toolchain }}
        run: |
          set -euo pipefail
          if [ "${BUILD_SYSTEM}" = 'cmake' ]; then
            if [ ! -f "${CMAKE_SOURCE_DIR}/CMakeLists.txt" ]; then
              echo "::error::${CMAKE_SOURCE_DIR}/CMakeLists.txt not found; set BUILD_SYSTEM/CMAKE_SOURCE_DIR, or switch BUILD_SYSTEM to 'script'."
              exit 1
            fi
            if [ -n "${MATRIX_TOOLCHAIN}" ] && [ ! -f "${MATRIX_TOOLCHAIN}" ]; then
              echo "::error::CMAKE toolchain file '${MATRIX_TOOLCHAIN}' for target '${{ matrix.target }}' does not exist."
              exit 1
            fi
          elif [ "${BUILD_SYSTEM}" = 'script' ]; then
            if [ ! -f "${BUILD_SCRIPT}" ]; then
              echo "::error::BUILD_SCRIPT '${BUILD_SCRIPT}' not found; point it at the repository's build script."
              exit 1
            fi
          else
            echo "::error::BUILD_SYSTEM must be 'cmake' or 'script' (got '${BUILD_SYSTEM}')."
            exit 1
          fi

      - name: Configure & build (CMake)
        if: env.BUILD_SYSTEM == 'cmake'
        env:
          MATRIX_TOOLCHAIN: ${{ matrix.cmake_toolchain }}
        run: |
          set -euo pipefail
          build_dir="build/${{ matrix.target }}"
          config_args=()
          if [ -n "${MATRIX_TOOLCHAIN}" ]; then
            config_args+=("-DCMAKE_TOOLCHAIN_FILE=${MATRIX_TOOLCHAIN}")
          fi
          read -r -a extra_args <<< "${CMAKE_EXTRA_ARGS}"
          cmake -S "${CMAKE_SOURCE_DIR}" -B "${build_dir}" \
            -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE}" \
            "${config_args[@]}" ${extra_args[@]+"${extra_args[@]}"}
          cmake --build "${build_dir}" --config "${CMAKE_BUILD_TYPE}" --parallel "$(nproc)"

      - name: Build (repository build script)
        if: env.BUILD_SYSTEM == 'script'
        env:
          HZ_TARGET: ${{ matrix.target }}
          HZ_BUILD_TYPE: ${{ env.CMAKE_BUILD_TYPE }}
          HZ_BUILD_DIR: ${{ github.workspace }}/build/${{ matrix.target }}
        run: |
          set -euo pipefail
          read -r -a extra_args <<< "${SCRIPT_BUILD_ARGS}"
          bash "${BUILD_SCRIPT}" ${extra_args[@]+"${extra_args[@]}"}

      - name: Run CTest suite
        if: env.CTEST_ENABLED == 'true'
        env:
          HZ_TARGET: ${{ matrix.target }}
        run: |
          set -euo pipefail
          build_dir="build/${{ matrix.target }}"
          if [ "${BUILD_SYSTEM}" != 'cmake' ] && ! find "${build_dir}" -name CTestTestfile.cmake -print -quit | grep -q .; then
            echo "::notice::No CTest suite found under ${build_dir}; skipping ctest."
            exit 0
          fi
          read -r -a extra_args <<< "${CTEST_EXTRA_ARGS}"
          ctest --test-dir "${build_dir}" -C "${CMAKE_BUILD_TYPE}" --output-on-failure ${extra_args[@]+"${extra_args[@]}"}

      - name: Smoke check built binaries
        if: env.SMOKE_TEST_COMMAND != ''
        env:
          HZ_TARGET: ${{ matrix.target }}
          HZ_BUILD_TYPE: ${{ env.CMAKE_BUILD_TYPE }}
          HZ_BUILD_DIR: ${{ github.workspace }}/build/${{ matrix.target }}
        run: |
          set -euo pipefail
          exe="${SMOKE_TEST_COMMAND%% *}"
          case "${exe}" in
            */*)
              if [ ! -f "${exe}" ]; then
                echo "::error::SMOKE_TEST_COMMAND script '${exe}' does not exist; create it or clear the variable."
                exit 1
              fi
              ;;
          esac
          bash -e -o pipefail -c "${SMOKE_TEST_COMMAND}"

      - name: Package distributable archive
        env:
          HZ_TARGET: ${{ matrix.target }}
        run: |
          set -euo pipefail
          version="${RELEASE_VERSION}"
          if [ -z "${version}" ]; then version="${GITHUB_SHA_SHORT::7}"; fi
          shopt -s nullglob globstar
          files=()
          while IFS= read -r glob; do
            glob="${glob%$'\r'}"
            [ -z "${glob}" ] && continue
            # shellcheck disable=SC2086 # word splitting is intentional for globs
            for entry in ${glob}; do files+=("${entry}"); done
          done <<EOF
          ${DIST_GLOBS}
          EOF
          if [ ${#files[@]} -eq 0 ]; then
            echo "::error::DIST_GLOBS matched no files; adjust the globs so the archive contains the built binaries."
            exit 1
          fi
          mkdir -p package
          archive="package/${PACKAGE_PREFIX}-${HZ_TARGET}-${version}.tar.gz"
          # shellcheck disable=SC2086 # tar recursion on directories is intended
          tar -czf "${archive}" "${files[@]}"
          echo "Created ${archive}"
          tar -tzf "${archive}"

      - name: Upload per-target archive artifact
        uses: actions/upload-artifact@v6
        with:
          name: daemon-cli-${{ matrix.target }}
          path: package/*
          if-no-files-found: error
          retention-days: ${{ env.ARTIFACT_RETENTION_DAYS }}

  github-release:
    name: Attach archives to GitHub Release
    needs: [release-gate, build]
    if: needs.release-gate.outputs.should-publish == 'true'
    runs-on: ubuntu-latest
    timeout-minutes: 15
    # Create this environment in the product repository (optionally with
    # required reviewers) so releases can be approved/protected.
    environment: release
    permissions:
      contents: write # required to create the GitHub Release and upload assets
    steps:
      - name: Download staged archive artifacts
        uses: actions/download-artifact@v7
        with:
          pattern: daemon-cli-*
          merge-multiple: true
          path: release-assets

      - name: Fail fast when no release assets were produced
        working-directory: release-assets
        run: |
          set -euo pipefail
          count="$(find . -maxdepth 1 -type f | wc -l)"
          if [ "${count}" -eq 0 ]; then
            echo '::error::No daemon/CLI archives found; nothing to attach to the release.'
            exit 1
          fi

      - name: Generate SHA-256 checksums
        working-directory: release-assets
        run: |
          set -euo pipefail
          find . -maxdepth 1 -type f -print0 | sort -z | xargs -0 sha256sum > SHA256SUMS.txt
          cat SHA256SUMS.txt

      - name: Create GitHub Release and upload assets
        uses: softprops/action-gh-release@v3
        with:
          tag_name: ${{ needs.release-gate.outputs.tag }}
          name: ${{ needs.release-gate.outputs.tag }}
          prerelease: ${{ needs.release-gate.outputs.prerelease == 'true' }}
          generate_release_notes: true
          fail_on_unmatched_files: true
          files: |
            release-assets/*
        env:
          GITHUB_TOKEN: ${{ secrets.GITHUB_TOKEN }}

  "narrative": {
    "northStar": "A public instrument, read in daylight",
    "overview": "HazardNet is read outdoors on cheap Android phones by someone deciding whether their district is at risk today. Apple's language suits this because it is restraint under load: large quiet surfaces, one idea per screen, type doing the structural work, colour reserved for meaning. What is taken: the neutral ramp, the label hierarchy, the tint system, generous vertical rhythm, a single deep shadow, type as the primary hierarchy device. What is refused: marketing gestures \u2014 no full-bleed product theatre, no scroll-choreographed reveals, no oversized display type floating in empty space.",
    "keyCharacteristics": [
      "One accent, one shadow \u2014 and not on UI.",
      "No hover state is ever the only affordance.",
      "Severity is colour, glyph and word together.",
      "Two density tracks, one spacing scale.",
      "The no-JS shell is a surface, held to the same rules."
    ],
    "rules": [
      {
        "name": "One accent",
        "body": "Interactive chrome uses Action Blue and nothing else. There is no second accent, no brand gradient, no colour used for personality.",
        "section": "colors"
      },
      {
        "name": "Colour carries meaning only",
        "body": "If a colour does not indicate a hazard, a status, or interactivity, it is neutral.",
        "section": "colors"
      },
      {
        "name": "One shadow, and not on UI",
        "body": "Elevation is a single deep shadow used where depth genuinely communicates layering, and it is not applied to interface chrome.",
        "section": "elevation"
      },
      {
        "name": "Cards are not the default container",
        "body": "Content flows on the ground and is separated by spacing and alignment. A card earns its place when it groups something that must travel together, and cards are never nested.",
        "section": "layout"
      },
      {
        "name": "No hover-only affordance",
        "body": "Hover may refine an interaction; it may never be the only way to discover one.",
        "section": "typography"
      },
      {
        "name": "A hazard level reads at first paint",
        "body": "No level, threshold or warning animates in, and no hazard colour transitions on load.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do carry a hazard level with colour, glyph and word together.",
      "Do separate sections with space and reach for a card only when the group must travel.",
      "Do set tabular data in tabular-nums, in the mono face, at a ramp step.",
      "Do theme the browser's own surfaces \u2014 selection, caret, scrollbar, focus ring, underline.",
      "Do let a heading carry its own weight; a group label is that group's heading.",
      "Do keep one authored motion moment per screen, starting from an already-visible default."
    ],
    "donts": [
      "Don't introduce a second accent, a brand gradient, or a colour used for personality.",
      "Don't put a shadow on UI chrome, and never a zero-offset coloured halo.",
      "Don't put a label or kicker above a heading.",
      "Don't use a coloured side stripe above 1px on a card, callout or alert.",
      "Don't nest cards, or reach for a card grid as the page structure.",
      "Don't ship a size, radius, colour or font that is not in the front matter.",
      "Don't let a hazard level animate in, transition, or hide behind hover.",
      "Don't use emoji or unicode glyphs as icons; the set is drawn and generated."
    ]
  }
}

      "html": "<div class=\"ds-card\"><h3 class=\"ds-card-title\">Monsoon flood</h3><p class=\"ds-card-body\">Riverine inundation across the Brahmaputra, Jamuna and Padma floodplains.</p></div>",
      "css": ".ds-card{border:1px solid var(--ap-hairline,#e0e0e0);border-radius:var(--ap-radius-lg,16px);background:var(--ap-canvas,#fff);padding:24px}.ds-card-title{margin:0;font-size:21px;line-height:26px;font-weight:600;letter-spacing:-0.006em;color:var(--ap-label,#1d1d1f)}.ds-card-body{margin:8px 0 0;max-width:65ch;font-size:17px;line-height:24px;color:var(--ap-label-secondary,#6e6e73)}"

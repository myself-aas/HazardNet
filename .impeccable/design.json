      "html": "<a class=\"ds-btn-ghost\" href=\"#\">Read the methodology</a>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 24px;border-radius:var(--ap-radius-md,12px);border:1px solid var(--ap-hairline,#e0e0e0);background:transparent;color:var(--ap-label,#1d1d1f);font-family:inherit;font-size:14px;font-weight:500;text-decoration:none;transition:transform 120ms cubic-bezier(.4,0,.2,1),border-color 160ms}.ds-btn-ghost:hover{border-color:var(--ap-label-secondary,#6e6e73)}.ds-btn-ghost:active{transform:scale(.97)}.ds-btn-ghost:focus-visible{outline:2px solid var(--ap-focus-ring,#0071e3);outline-offset:2px}"

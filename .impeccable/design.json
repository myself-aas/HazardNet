      "name": "Button \u2014 filled",
      "kind": "button",
      "refersTo": "ButtonLink intent=solid",
      "description": "The single primary action on a surface. Action Blue fill, ink-weight label, press scale.",
      "html": "<a class=\"ds-btn-filled\" href=\"#\">Open the live map</a>",
      "css": ".ds-btn-filled{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:12px 24px;border-radius:var(--ap-radius-md,12px);background:var(--ap-primary,#0066cc);color:var(--ap-on-primary,#fff);font-family:inherit;font-size:14px;font-weight:500;line-height:18px;letter-spacing:-0.002em;text-decoration:none;transition:transform 120ms cubic-bezier(.4,0,.2,1),background 160ms}.ds-btn-filled:hover{background:var(--ap-primary-focus,#0071e3)}.ds-btn-filled:active{transform:scale(.97)}.ds-btn-filled:focus-visible{outline:2px solid var(--ap-focus-ring,#0071e3);outline-offset:2px}"
    },

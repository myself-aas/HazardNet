rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    // Only a trusted Admin SDK operator may assign custom claims.
    function admin() { return signedIn() && request.auth.token.get('admin', false) == true; }
    function publicProfileValid() {
      return request.resource.data.keys().hasOnly([
        'display_name', 'username', 'photo_url', 'bio', 'user_role', 'organization',
        'country', 'division', 'district', 'primary_division', 'primary_district',
        'nationality', 'preferred_language', 'occupation', 'target_crops',
        'farm_size_hectares', 'farming_experience_years', 'irrigation_type', 'soil_type',
        'website', 'social_facebook', 'social_x', 'social_linkedin', 'social_github',
        'social_youtube', 'social_instagram', 'created_at', 'profile_visibility'
      ]) && request.resource.data.profile_visibility in ['public', 'private']
      && (request.resource.data.profile_visibility == 'public'
        || request.resource.data.keys().hasOnly(['username', 'profile_visibility']));
    }
    match /forecasts/{id} {
      allow read: if true;
      allow write: if false; // trusted Admin SDK only, never public client writes
    }
    match /profiles/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid);
    }
    match /public_profiles/{uid} {
      allow read: if true; // contains only the explicit public projection
      allow create, update: if owner(uid) && publicProfileValid();
      allow delete: if owner(uid);
    }
    match /users/{uid} { allow read, write: if owner(uid); }
    match /user_connectors/{id} {
      allow read, delete: if owner(resource.data.user_id);
      allow create: if owner(request.resource.data.user_id);
      allow update: if owner(resource.data.user_id)
        && request.resource.data.user_id == resource.data.user_id;
    }
    match /blog_articles/{id} {
      allow read: if resource.data.status == 'published' || admin() || owner(resource.data.author_id);
      allow create: if owner(request.resource.data.author_id)
        && request.resource.data.status in ['draft', 'published'];
      allow update: if (admin() || owner(resource.data.author_id))
        && request.resource.data.author_id == resource.data.author_id
        && request.resource.data.status in ['draft', 'published'];
      allow delete: if admin() || owner(resource.data.author_id);
    }
    match /assessments/{id} {
      allow read, delete: if owner(resource.data.user_id);
      allow create: if owner(request.resource.data.user_id);
      allow update: if owner(resource.data.user_id)
        && request.resource.data.user_id == resource.data.user_id;
    }
    match /alerts/{id} {
      allow read, delete: if owner(resource.data.user_id);
      allow create: if owner(request.resource.data.user_id);
      allow update: if owner(resource.data.user_id)
        && request.resource.data.user_id == resource.data.user_id;
    }
    match /{document=**} { allow read, write: if false; }
  }
}

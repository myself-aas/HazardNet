rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (default deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ---------------------------------------------------------------------------
    // Ownership spelling (Phase 6 fix, SEC-13)
    //
    // The client writes snake_case — `AuthContext.saveAssessment` posts `user_id`,
    // `updateUserProfile` snake-cases every camelCase field before the write — while these
    // rules read camelCase (`userId`). On a client-written document the old check compared
    // `undefined` with the caller's uid, so the owner was denied their own row and the
    // validators never ran. Accepting both spellings restores the intent and keeps the
    // SQL mirror (scripts/db/003_user_dashboard.sql) readable.
    //
    // NOTE: verifying these rules needs the Firestore emulator (Java) or a real project;
    // neither is available in the audit sandbox, so the shape is pinned by
    // `__tests__/firestoreRules.test.js` and the emulator run is an owner action in
    // docs/ops/owner-actions.md.
    // ---------------------------------------------------------------------------
    function ownerOf(data) {
      return 'user_id' in data
        ? data.user_id
        : (('userId' in data) ? data.userId : null);
    }

    function isCallerOwned(data) {
      return ownerOf(data) is string && ownerOf(data) == request.auth.uid;
    }

    /** Present under either spelling (a required field must be present at all). */
    function hasEither(data, snake, camel) {
      return (snake in data) || (camel in data);
    }

    /** Bounded when present: free-text fields are the ones that can be used to store junk. */
    function boundedString(data, field, max) {
      return (!(field in data) || (data[field] is string && data[field].size() <= max));
    }

    function boundedNumber(data, field) {
      return (!(field in data) || data[field] is number);
    }

    /** A document that keeps growing is storage abuse the rules can see. */
    function withinKeyBudget(data, max) {
      return data.keys().size() <= max;
    }

    // Validation helper for the profile document the app actually writes
    // (snake_case, see AuthContext.saveProfile / bootstrapProfileFromOAuth /
    // updateUserProfile). Identity fields must agree with the caller; free-text fields are
    // length-capped; `role` stays inside the two values the UI understands. Authorization
    // never reads this document — the backend takes the role from verified token claims
    // (backend/middleware/firebaseAuth.js) — so a stored role is display data only.
    function isValidUserProfile(data) {
      return withinKeyBudget(data, 60)
        && (!('id' in data) || (data.id is string && data.id == request.auth.uid))
        && (!('uid' in data) || (data.uid is string && data.uid == request.auth.uid))
        && (!('user_id' in data) || (data.user_id is string && data.user_id == request.auth.uid))
        && boundedString(data, 'email', 255)
        && boundedString(data, 'display_name', 150)
        && boundedString(data, 'displayName', 150)
        && boundedString(data, 'username', 80)
        && boundedString(data, 'photo_url', 1500)
        && boundedString(data, 'photoURL', 1500)
        && boundedString(data, 'organization', 250)
        && boundedString(data, 'target_crops', 500)
        && boundedString(data, 'targetCrops', 500)
        && boundedString(data, 'bio', 2000)
        && boundedString(data, 'address', 500)
        && boundedString(data, 'website', 300)
        && boundedString(data, 'phone_number', 50)
        && boundedString(data, 'phoneNumber', 50)
        && boundedString(data, 'whatsapp_number', 50)
        && boundedString(data, 'primary_division', 100)
        && boundedString(data, 'primaryDivision', 100)
        && boundedString(data, 'primary_district', 100)
        && boundedString(data, 'primaryDistrict', 100)
        && boundedString(data, 'home_district_id', 100)
        && boundedString(data, 'home_district_name', 150)
        && (!('role' in data) || (data.role == 'user' || data.role == 'admin'))
        && boundedString(data, 'user_role', 100)
        && boundedString(data, 'userRole', 100)
        && boundedNumber(data, 'farm_size_hectares')
        && boundedNumber(data, 'farmSizeHectares')
        && boundedNumber(data, 'pinpoint_lat')
        && boundedNumber(data, 'pinpoint_lng');
    }

    // Validation helper for Assessment (client writes `user_id` + snake_case fields;
    // camelCase is accepted for documents written by the server/SQL mirror).
    function isValidAssessment(data) {
      return hasEither(data, 'user_id', 'userId')
        && isCallerOwned(data)
        && withinKeyBudget(data, 60)
        && hasEither(data, 'district_id', 'districtId')
        && hasEither(data, 'district_name', 'districtName')
        && hasEither(data, 'primary_hazard', 'primaryHazard')
        && boundedString(data, 'district_id', 50)
        && boundedString(data, 'districtId', 50)
        && boundedString(data, 'district_name', 100)
        && boundedString(data, 'districtName', 100)
        && boundedString(data, 'primary_hazard', 100)
        && boundedString(data, 'primaryHazard', 100)
        && boundedString(data, 'notes', 1000)
        && boundedString(data, 'user_email', 255)
        && boundedString(data, 'userEmail', 255)
        && boundedString(data, 'severity_bin', 50)
        && boundedString(data, 'severityBin', 50)
        && boundedNumber(data, 'severity_score')
        && boundedNumber(data, 'severityScore')
        && boundedNumber(data, 'confidence')
        && boundedString(data, 'created_at', 40)
        && boundedString(data, 'createdAt', 40);
    }

    // Validation helper for UserAlert — same spelling rules as Assessment.
    function isValidUserAlert(data) {
      return hasEither(data, 'user_id', 'userId')
        && isCallerOwned(data)
        && withinKeyBudget(data, 60)
        && hasEither(data, 'district_id', 'districtId')
        && hasEither(data, 'hazard_type', 'hazardType')
        && boundedString(data, 'district_id', 50)
        && boundedString(data, 'districtId', 50)
        && boundedString(data, 'hazard_type', 50)
        && boundedString(data, 'hazardType', 50)
        && boundedNumber(data, 'severity_threshold')
        && boundedNumber(data, 'severityThreshold')
        && boundedString(data, 'created_at', 40)
        && boundedString(data, 'createdAt', 40);
    }

    // Forecast bulletins are PUBLIC data: anyone may read them (the website's
    // live layer + the Vercel GET handlers when FORECAST_STORE=firestore).
    // Writes stay denied here on purpose — ingest goes through the
    // authenticated backend into the Firestore store;
    // the unauthenticated client SDK must never be able to poison bulletins.
    match /forecasts/{forecastId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    // Matching Collections
    match /profiles/{userId} {
      allow get, list: if true;
      // The validator was defined but never applied until Phase 6 — it existed while
      // profile writes were gated on ownership alone (any field, any size).
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    // Connector rows are per-user documents keyed `${uid}_${connectorKey}`
    // (see frontend/src/lib/connectors.ts). The previous rule — `if isSignedIn()`
    // — let ANY authenticated account read and overwrite ANY other account's
    // connector configuration, which includes webhook URLs and connector auth
    // data (audit SEC-01/SEC-09, 2026-09-17). Ownership is taken from the
    // document's own `user_id`, never from the id the client supplied.
    match /user_connectors/{connectorId} {
      allow get: if isSignedIn() && isCallerOwned(existing());
      allow list: if isSignedIn() && isCallerOwned(resource.data);
      allow create: if isSignedIn() && isCallerOwned(incoming());
      allow update: if isSignedIn() && isCallerOwned(existing()) && isCallerOwned(incoming());
      allow delete: if isSignedIn() && isCallerOwned(existing());
    }

    // Blog articles — the public SEO surface. Reads stay public (published
    // articles are meant to be read and indexed). Writes were `if isSignedIn()`,
    // so any authenticated visitor could publish, edit or delete content on the
    // public site; the superadmin check existed only in the UI
    // (frontend/src/components/blog/RequireSuperAdmin.tsx). Writes are now
    // pinned to the same allowlist as frontend/src/lib/superadmins.ts
    // (scripts/db/006_blog_articles_rls_authz.sql) and the UI gate
    // (frontend/src/lib/superadmins.ts); scripts/tests/test_blog_authz_parity.py
    // fails CI if the three lists drift apart.
    function isBlogSuperadmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'shuvo.1807016@bau.edu.bd',
          'shuvoasifahmed@gmail.com',
          'asifahmedshuvo.aas@gmail.com'
        ];
    }

    match /blog_articles/{articleId} {
      allow get, list: if true;
      allow create, update, delete: if isBlogSuperadmin();
    }

    // Assessments are keyed by a random doc id, so ownership has to come from the
    // document body — and the body uses `user_id` (see the note on ownerOf()).
    match /assessments/{assessmentId} {
      allow get: if isSignedIn() && isCallerOwned(existing());
      allow list: if isSignedIn() && isCallerOwned(resource.data);
      allow create: if isSignedIn() && isValidId(assessmentId) && isValidAssessment(incoming());
      allow update: if isSignedIn() && isValidId(assessmentId)
        && isCallerOwned(existing()) && isValidAssessment(incoming());
      allow delete: if isSignedIn() && isCallerOwned(existing());
    }

    match /alerts/{alertId} {
      allow get: if isSignedIn() && isCallerOwned(existing());
      allow list: if isSignedIn() && isCallerOwned(resource.data);
      allow create: if isSignedIn() && isValidId(alertId) && isValidUserAlert(incoming());
      allow update: if isSignedIn() && isValidId(alertId)
        && isCallerOwned(existing()) && isValidUserAlert(incoming());
      allow delete: if isSignedIn() && isCallerOwned(existing());
    }
  }
}
